         </Borders>
         <Font ss:FontName="Arial" ss:Size="8" />
         <Alignment ss:WrapText="1" />
      </Style>
      <Style ss:ID="StyleNoFill">
         <Font ss:FontName="Arial" ss:Size="8" />
         <Interior ss:Color="#FFFFFF" ss:Pattern="Solid" />
         <Alignment ss:WrapText="1" />
      </Style>
   </Styles>
